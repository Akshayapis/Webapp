# U APP environment — pre-filled. Set secrets in Render → Environment.
# Firebase client config is embedded in src/data/catalog.ts and works as-is.
VITE_FIREBASE_PROJECT_ID=dmakenow
VITE_FIREBASE_DATABASE_URL=https://dmakenow-default-rtdb.firebaseio.com

# ---------------------------------------------------------------------------
# Kaggle Android build engine (SERVER ONLY — never exposed to the browser)
# ---------------------------------------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_TIMEOUT_MINUTES=30
KAGGLE_WORKER_SLUG=uapp-android-build-worker

# Firebase token verification for build requests
FIREBASE_PROJECT_ID=dmakenow
FIREBASE_DATABASE_URL=https://dmakenow-default-rtdb.firebaseio.com
REQUIRE_AUTH=true

# Temporary artifact storage (mount a Render persistent disk at /var/uapp-data)
DATA_DIR=/var/uapp-data
DOWNLOAD_TTL_SECONDS=540
BUILD_UPLOAD_SECRET=

# Public URL of this Render service
APP_URL=

# Optional: live ad mediation endpoint and merchant UPI
VITE_UAPP_ADS_ENDPOINT=
VITE_UAPP_UPI_ID=
VITE_UAPP_UPI_NAME=
